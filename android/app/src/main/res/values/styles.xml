<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!--
        androidx.core:core-splashscreen backports the Android 12 SplashScreen
        API to API < 31 using these exact attribute names — a plain
        android:background here is a no-op for the compat theme (it only draws
        from windowSplashScreenBackground/windowSplashScreenAnimatedIcon, the
        same ones values-v31/styles.xml sets for real Android 12+), which is
        why the logo wasn't showing pre-12. Also needs MainActivity to call
        SplashScreen.installSplashScreen(this) before super.onCreate() — the
        compat library does nothing without that call.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <!--
            @drawable/ic_splash_icon, not @mipmap/ic_launcher_foreground — the
            latter is the adaptive-icon foreground LAYER, meant to be rendered
            through the adaptive-icon system's own mask/safe-zone/inset handling
            (see mipmap-anydpi-v26/ic_launcher.xml). windowSplashScreenAnimatedIcon
            has no such system: it draws whatever it's given directly, and the
            raster mipmap rendered blank there — a self-contained vector sized to
            fit Android's splash icon budget (240dp) is what actually shows up.
        -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>